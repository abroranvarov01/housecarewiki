{
  "name": "housecarewiki",
  "version": "2.0.0",
  "private": true,
  "description": "HouseCareWiki.com — Practical Home Care Encyclopedia, Independent Product Reviews & Smart Tools (US Edition)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node scripts/optimize-images.cjs",
    "validate:content": "node scripts/validate-content.cjs",
    "prebuild": "npm run validate:content",
    "ig": "node scripts/ig.mjs",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "prisma": "6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.4.5",
    "vitest": "3.2.7"
  }
}
